# Teste de Normaliza??o
normalizado = function(db)
{
  db$Qntd_norm_masc = (db$Qntd_masc - min(db$Qntd_masc))/(max(db$Qntd_masc)-min(db$Qntd_masc))
  db$Qntd_norm_fem = (db$Qntd_fem - min(db$Qntd_fem))/(max(db$Qntd_fem)-min(db$Qntd_fem))
  db$Qntd_norm_total = (db$Qntd_total - min(db$Qntd_total))/(max(db$Qntd_total)-min(db$Qntd_total))
  db$Tx_norm_masc = (db$Taxa_masc - min(db$Taxa_masc))/(max(db$Taxa_masc)-min(db$Taxa_masc))
  db$Tx_norm_fem = (db$Taxa_fem - min(db$Taxa_fem))/(max(db$Taxa_fem)-min(db$Taxa_fem))
  db$Tx_norm_total = (db$Taxa_total - min(db$Taxa_total))/(max(db$Taxa_total)-min(db$Taxa_total))
  
  return(db)
}

