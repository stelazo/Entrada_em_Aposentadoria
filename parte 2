# TESTE DE TRANSLA??O DA IDADE DE APOSENTADORIA FMEININO EM +5 ANOS
teste_translacao = function(tx, title)
{ 
  tx_fem = tx[,c("idadeaposentadoria","Taxa_fem")] 
  tx_masc = tx[,c("idadeaposentadoria","Taxa_masc")]
  
  tx_fem$idadeaposentadoria = tx_fem$idadeaposentadoria + 5
  
  tx_fem = filter(tx_fem, between(tx_fem$idadeaposentadoria,
                                  55,
                                  75))
  
  tx_masc = filter(tx_masc, between(tx_masc$idadeaposentadoria,
                                    55,
                                    75))
  
  plot(tx_fem$idadeaposentadoria, tx_fem$Taxa_fem,
       type = "lines",
       col = "red",
       main =  title,
       xlab = "Idade de Aposentadoria",
       ylab = "Taxa de aposentadoria",
       cex.lab = 0.8,
       cex.axis = 0.8,
       cex.main = 0.9)
  lines(tx_masc$idadeaposentadoria, tx_masc$Taxa_masc,
        col = "blue")
  legend("right",
         legend = c("Feminino", "Masculino"),
         col = c("red", "blue"),
         lty = 1:1,
         cex = 0.7, box.lty=0 )
  
  
  my_test = ks.test(tx_fem$Taxa, tx_masc$Taxa)
  
  return(my_test)
}

# Teste de Padroniza??o
padronizado = function(db)
{
  db$Qntd_padr_masc = (db$Qntd_masc - mean(db$Qntd_masc))/sd(db$Qntd_masc)
  db$Qntd_padr_fem = (db$Qntd_fem - mean(db$Qntd_fem))/sd(db$Qntd_fem)  
  db$Qntd_padr_total = (db$Qntd_total - mean(db$Qntd_total))/sd(db$Qntd_total)    
  db$Tx_padr_masc = (db$Taxa_masc - mean(db$Taxa_masc))/sd(db$Taxa_masc)
  db$Tx_padr_fem = (db$Taxa_fem - mean(db$Taxa_fem))/sd(db$Taxa_fem)  
  db$Tx_padr_total = (db$Taxa_total - mean(db$Taxa_total))/sd(db$Taxa_total)    
  
  return(db)
}

