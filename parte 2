# Teste de ader?ncia
# Suaviza??o por Kernel
teste_aderencia = function(tx, title)
{
  tx = tx[,c("idadeaposentadoria","Taxa_total")] 
  v = data.frame( bkde(tx$Taxa, gridsize =  length(tx$Taxa)))
  var(tx$Taxa)
  v = data.frame(x = v$x , y = (v$y / sum(v$y)))
  sum(v$y)
  v$Taxa = tx$Taxa
  v$idadeaposentadoria = tx$idadeaposentadoria
  plot(v$idadeaposentadoria,
       v$Taxa,
       type = "p",
       col = "darkblue",
       ylab = "Taxa de Aposentadoria",
       xlab = "Idade de Aposentadoria",
       main = title)
  lines(v$idadeaposentadoria, v$y)
  inicio = which(v$y == max(v$y))
  fim= length(v$x)
  # Testando se a fun??o ? decrescente
  v$y[inicio:(fim-1)] > v$y[(inicio+1):fim]
  sum(v$y[inicio:(fim-1)] < v$y[(inicio+1):fim])
  my_test = ks.test(v$y,v$Taxa)
  return(my_test)
}

