# Fun??o para calculo de taxas 
taxas_carreira = function(db)
{
  p1 = db %>%                             
    group_by(idadeaposentadoria) %>%
    count()
  fem = filter(db,db$CO_SEXO_APOSENTADO == 1) %>%
    group_by(idadeaposentadoria) %>%
    count()
  
  masc = filter(db,db$CO_SEXO_APOSENTADO == 2) %>%
    group_by(idadeaposentadoria) %>%
    count()
  
  z = p1 %>%
    full_join(masc, by = "idadeaposentadoria") %>%
    full_join(fem, by = "idadeaposentadoria")
  
  z[is.na(z)] = 0
  
  x = data.frame(idadeaposentadoria = p1$idadeaposentadoria,
                 Qntd_total = z$n.x,
                 Qntd_masc = z$n.y,
                 Qntd_fem = z$n,
                 Taxa_total = (z$n.x / sum(z$n.x)),
                 Taxa_masc = (z$n.y / sum(z$n.x)),
                 Taxa_fem = (z$n / sum(z$n.x)))
  return(x)
}

