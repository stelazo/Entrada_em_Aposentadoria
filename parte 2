#Funcao para plotar graficos dos demais servidores por sexo , grafico idade X n?mero de aposentados

plot_demais = function(db, title, sexo, f) 
{
  v = data.frame(idadeaposentadoria = db$idadeaposentadoria,
                 CO_SEXO_APOSENTADO = db$CO_SEXO_APOSENTADO,
