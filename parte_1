# Base de inativos 
i2021 = i2021 %>% distinct(i2021$ID_APOSENTADO_CPF, .keep_all = TRUE)
i2021$data_focal =  rep(as.Date("2021/04/30"), length(i2021$ID_APOSENTADO_CPF))
#Reformulate how to calculate retirement age
i2021$idadeaposentadoria = floor ((i2021$DT_INICIO_APOSENTADORIA -i2021$DT_NASC_APOSENTADO)/365.25)

i2021$idadeaposentadoria = as.numeric(i2021$idadeaposentadoria)

i2021$anoaposentadoria = lubridate::year(i2021$DT_INICIO_APOSENTADORIA)

averbacao_total = (i2021$NU_TEMPO_RPPS_MUN + i2021$NU_TEMPO_RPPS_EST + i2021$NU_TEMPO_RPPS_FED)
i2021$TEMPO_CONTR_TOTAL = difftime(as.POSIXct(i2021$DT_INICIO_APOSENTADORIA),
                                   as.POSIXct(i2021$DATA_DE_INGRESSO_NO_ENTE, tz="UTC"),
                                   units="days") + 
  ifelse(i2021$CO_COMP_MASSA == 2, 
         ifelse(averbacao_total <= 14610,
                averbacao_total,
                14610),
         averbacao_total)

i2021$TEMPO_CONTR_TOTAL = floor(i2021$TEMPO_CONTR_TOTAL/365.25) 

# Filtrando aposentadorias programas 
# N?o foram consideradas:
#    1. Aposentadorias por invalidez;
#    2. Aposentadorias com menos de 20 anos de contribui??o;
#    3. Aposentadorias com idade inicial menor que 40 e maior que 70; e
#    4. Aposentadorias concedidas antes de 2010 e depois de 2019.
i2021 = filter(i2021, i2021$CO_TIPO_APOSENTADORIA != 4)
i2021 = filter(i2021, i2021$TEMPO_CONTR_TOTAL > 20)
i2021 = filter(i2021, between(i2021$idadeaposentadoria, 40 , 75))
i2021 = filter(i2021, lubridate::year(i2021$DT_INICIO_APOSENTADORIA) >= 2010 &
                 lubridate::year(i2021$DT_INICIO_APOSENTADORIA) <= 2019 )

